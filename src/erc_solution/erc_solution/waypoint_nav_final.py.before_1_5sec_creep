def yaw_from_quat(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


def angle_diff(a, b):
    d = a - b
    while d > math.pi:
        d -= 2 * math.pi
    while d < -math.pi:
        d += 2 * math.pi
    return d


class WaypointNavFinal(Node):
    def __init__(self):
        super().__init__('waypoint_nav_final')
        self.declare_parameter('target_column', 1)
        self.declare_parameter('book_colour', 'red')
        self.target_column = self.get_parameter('target_column').value
        self.target_colour = self.get_parameter('book_colour').value

        self.bridge = CvBridge()
        self.latest_rgb = None
        self.latest_depth = None
        self.fx = self.fy = self.cx = self.cy = None
        self.current_x = self.current_y = self.current_yaw = None
        self.digit_templates = self._build_digit_templates()
        self.tf_buffer = tf2_ros.Buffer()
        self.tf_listener = tf2_ros.TransformListener(self.tf_buffer, self, spin_thread=True)

        self.create_subscription(CameraInfo, CAMERA_INFO_TOPIC, self.camera_info_cb, qos_profile_sensor_data)
        self.create_subscription(Image, DEPTH_TOPIC, self.depth_cb, qos_profile_sensor_data)
        self.create_subscription(Image, RGB_TOPIC, self.rgb_cb, qos_profile_sensor_data)
        self.create_subscription(Odometry, '/odom', self.odom_cb, 10)
        self.create_subscription(Bool, GRASP_RESULT_TOPIC, self.grasp_result_cb, 10)
        self.create_subscription(
            Bool,
            LIFT_RESULT_TOPIC,
            self.lift_result_cb,
            10
        )
        self.create_subscription(Bool, PLACE_RESULT_TOPIC, self.place_result_cb, 10)
        self.bin_point_pub = self.create_publisher(PointStamped, BIN_POINT_TOPIC, 10)
        self._place_result = None
        self._bin_scan_tilt_sent = False
        self._bin_scan_dwell = 0.0
        self.create_subscription(Bool, READY_TO_CREEP_TOPIC, self.ready_to_creep_cb, 10)
        self.create_subscription(Contacts, CONTACTS_TOPIC, self.contacts_cb, 10)
        self.creep_contact_pub = self.create_publisher(Bool, CREEP_CONTACT_TOPIC, 10)
        self.backout_complete_pub = self.create_publisher(
            Bool,
            BACKOUT_COMPLETE_TOPIC,
            10
        )
        self._ready_to_creep = False
        self._creep_start_x = None
        self._creep_start_y = None
        self._creep_distance = 0.0
        self._backout_start_x = None
        self._backout_start_y = None
        self._contact_detected = False
        self._contact_time = None
        self._grasp_result = None  # None = not received yet, True/False once manipulation_node replies
        self._lift_result = None
        self._grasp_wait_elapsed = 0.0

        self.cmd_pub = self.create_publisher(Twist, '/cmd_vel', 10)
        self.arm_right_pub = self.create_publisher(JointTrajectory, '/arm_right_controller/joint_trajectory', 10)
        self.head_pub = self.create_publisher(JointTrajectory, '/head_controller/joint_trajectory', 10)
        self.col_pub = self.create_publisher(Int32, COL_TOPIC, 10)
        self.row_pub = self.create_publisher(Int32, ROW_TOPIC, 10)
        self.point_pub = self.create_publisher(PointStamped, GRASP_POINT_TOPIC, 10)

        self.state = 'HEAD_INIT'
        self._wait_ticks = int(1.2 / 0.1)
        self._search_elapsed = 0.0
        self._lost_ticks = 0
        self._target_slot_idx = None
        self._nav_target = None   # (x, y, yaw) currently driving to
        self._nav_substate = 'ROTATE_TO_FACE'
        self._book_dwell = 0.0
        self._book_tilt_sent = False
        self._book_scan_attempts = 0

        self.get_logger().info(f'Searching for shelf {self.target_column}, then {self.target_colour} book...')
        self.create_timer(0.1, self.control_loop)

    # ---------------------------------------------------------- callbacks
    def camera_info_cb(self, msg):
        self.fx, self.fy = msg.k[0], msg.k[4]
        self.cx, self.cy = msg.k[2], msg.k[5]

    def depth_cb(self, msg):
        self.latest_depth = self.bridge.imgmsg_to_cv2(msg, desired_encoding='32FC1')

    def rgb_cb(self, msg):
        self.latest_rgb = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')

    def odom_cb(self, msg):
        self.current_x = msg.pose.pose.position.x
        self.current_y = msg.pose.pose.position.y
        self.current_yaw = yaw_from_quat(msg.pose.pose.orientation)

    def grasp_result_cb(self, msg):
        self._grasp_result = msg.data

    def lift_result_cb(self, msg):
        self._lift_result = msg.data

    def place_result_cb(self, msg):
        self._place_result = msg.data

    def ready_to_creep_cb(self, msg):
        if msg.data:
            self._ready_to_creep = True

    def contacts_cb(self, msg):
        if self._contact_detected:
            return
        for c in msg.contacts:
            if GRIPPER_LEFT_LINK_PREFIX in c.collision1.name or GRIPPER_LEFT_LINK_PREFIX in c.collision2.name:
                self.get_logger().info(f'Gripper contact detected: {c.collision1.name} <-> {c.collision2.name}')
                self._contact_detected = True
                return

    def _row_from_base_link_z(self, z_base_link):
        for i, boundary in enumerate(ROW_BOUNDARIES):
            if z_base_link > boundary:
                return i + 1
        return len(ROW_BOUNDARIES) + 1

    # ---------------------------------------------------------- digit OCR
    def _build_digit_templates(self):
        templates = {}
        for d in range(1, 6):
            canvas = np.zeros((64, 64), dtype=np.uint8)
            cv2.putText(canvas, str(d), (10, 50), cv2.FONT_HERSHEY_SIMPLEX,
                        1.8, 255, 4, cv2.LINE_AA)
            templates[d] = canvas
        return templates

    def _ocr_digit(self, crop_gray):
        scale = max(1, 100 // max(crop_gray.shape[0], 1))
        big = cv2.resize(crop_gray, None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC)
        _, big_bw = cv2.threshold(big, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)
        if HAVE_TESSERACT:
            for cfg in ['--psm 7 -c tessedit_char_whitelist=12345',
                        '--psm 8 -c tessedit_char_whitelist=12345']:
                txt = pytesseract.image_to_string(big_bw, config=cfg).strip()
                if txt.isdigit() and 1 <= int(txt) <= 5:
                    return int(txt)
        best_score, best_digit = -1, None
        resized = cv2.resize(big_bw, (64, 64))
        for d, tmpl in self.digit_templates.items():
            res = cv2.matchTemplate(resized, tmpl, cv2.TM_CCOEFF_NORMED)
            score = res.max()
            if score > best_score:
                best_score, best_digit = score, d
        return best_digit if best_score > 0.35 else None

    def find_target_digit_x(self):
        if self.latest_rgb is None:
            return None
        gray = cv2.cvtColor(self.latest_rgb, cv2.COLOR_BGR2GRAY)
        h, w = gray.shape
        roi = gray[0:int(h * 0.6), :]
        _, thresh = cv2.threshold(roi, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        for c in contours:
            x, y, cw, ch = cv2.boundingRect(c)
            if cw < 8 or ch < 12 or cw > 200 or ch > 200:
                continue
            crop = roi[y:y + ch, x:x + cw]
            digit = self._ocr_digit(crop)
            if digit == self.target_column:
                return x + cw // 2
        return None

    # ---------------------------------------------------------- colour + depth
    def detect_colour(self, frame):
        h_full, w_full = frame.shape[:2]
        x_min = int(w_full * BOOK_ROI_X_MIN_FRAC)
        x_max = int(w_full * BOOK_ROI_X_MAX_FRAC)
        roi = frame[:, x_min:x_max]

        hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
        mask = np.zeros(hsv.shape[:2], dtype=np.uint8)
        for lower, upper in COLOR_RANGES[self.target_colour]:
            mask |= cv2.inRange(hsv, lower, upper)
        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5, 5), np.uint8))
        contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        if not contours:
            return None
        largest = max(contours, key=cv2.contourArea)
        if cv2.contourArea(largest) < MIN_CONTOUR_AREA:
            return None
        x, y, w, h = cv2.boundingRect(largest)
        # translate ROI-local pixel coords back into full-frame coords,
        # since publish_point()'s fx/fy/cx/cy intrinsics are for the full frame
        return (x + w // 2 + x_min, y + h // 2)

    def publish_point(self, px, py, depth):
        x = (px - self.cx) * depth / self.fx
        y = (py - self.cy) * depth / self.fy
        point_msg = PointStamped()
        point_msg.header.stamp = self.get_clock().now().to_msg()
        point_msg.header.frame_id = CAMERA_OPTICAL_FRAME
        point_msg.point.x, point_msg.point.y, point_msg.point.z = x, y, depth
        self.point_pub.publish(point_msg)

    # ---------------------------------------------------------- head/nav helpers
    def stow_right_arm(self):
        traj = JointTrajectory()
        traj.joint_names = ARM_RIGHT_JOINT_NAMES
        point = JointTrajectoryPoint()
        point.positions = ARM_RIGHT_STOW_POSITIONS
        point.time_from_start = Duration(sec=3, nanosec=0)
        traj.points = [point]
        self.arm_right_pub.publish(traj)

    def send_head(self, pan, tilt):
        traj = JointTrajectory()
        traj.joint_names = ['head_1_joint', 'head_2_joint']
        point = JointTrajectoryPoint()
        point.positions = [pan, tilt]
        point.time_from_start = Duration(sec=1, nanosec=0)
        traj.points = [point]
        self.head_pub.publish(traj)

    def start_nav_to(self, x, y, yaw):
        self._nav_target = (x, y, yaw)
        self._nav_substate = 'ROTATE_TO_FACE'

    def step_nav(self):
        """Closed-loop odometry drive to self._nav_target. Returns True once arrived."""
        if self.current_x is None or self._nav_target is None:
            return False
        tx, ty, tyaw = self._nav_target
        dx = tx - self.current_x
        dy = ty - self.current_y
        dist = math.hypot(dx, dy)

        if self._nav_substate == 'ROTATE_TO_FACE':
            if dist < POS_TOLERANCE_M:
                self._nav_substate = 'ROTATE_FINAL'
                return False
            heading = math.atan2(dy, dx)
            err = angle_diff(heading, self.current_yaw)
            if abs(err) < YAW_TOLERANCE_RAD:
                self.cmd_pub.publish(Twist())
                self._nav_substate = 'DRIVE_STRAIGHT'
                return False
            twist = Twist()
            twist.angular.z = max(min(0.8 * err, MAX_ANGULAR), -MAX_ANGULAR)
            self.cmd_pub.publish(twist)
            return False

        if self._nav_substate == 'DRIVE_STRAIGHT':
            local_forward = dx * math.cos(self.current_yaw) + dy * math.sin(self.current_yaw)
            if abs(local_forward) < POS_TOLERANCE_M and dist < POS_TOLERANCE_M * 2:
                self.cmd_pub.publish(Twist())
                self._nav_substate = 'ROTATE_FINAL'
                return False
            heading = math.atan2(dy, dx)
            heading_err = angle_diff(heading, self.current_yaw)
            if local_forward < 0:
                heading_err = 0.0
            twist = Twist()
            twist.linear.x = max(min(local_forward, MAX_LINEAR), -MAX_LINEAR)
            if abs(twist.linear.x) < 0.05:
                twist.linear.x = 0.05 if local_forward > 0 else -0.05
            twist.angular.z = max(min(0.5 * heading_err, 0.15), -0.15)
            self.cmd_pub.publish(twist)
            return False

        if self._nav_substate == 'ROTATE_FINAL':
            err = angle_diff(tyaw, self.current_yaw)
            if abs(err) < YAW_TOLERANCE_RAD:
                self.cmd_pub.publish(Twist())
                return True
            twist = Twist()
            twist.angular.z = max(min(0.8 * err, MAX_ANGULAR), -MAX_ANGULAR)
            self.cmd_pub.publish(twist)
            return False

        return False

    # ---------------------------------------------------------- main state machine
    def control_loop(self):
        if self.state == 'HEAD_INIT':
            self.stow_right_arm()
            self.send_head(0.0, TILT_UP)
            self._wait_ticks -= 1
            if self._wait_ticks <= 0:
                self.state = 'SEARCH'
                self.get_logger().info('Head set. Rotating (CW) to search for shelf number...')
            return

        if self.state == 'SEARCH':
            self._search_elapsed += 0.1
            if self._search_elapsed > SEARCH_TIMEOUT_S:
                self.cmd_pub.publish(Twist())
                self.get_logger().error(f'Search timed out, never found shelf {self.target_column}.')
                self.state = 'FAILED'
                return
            cx = self.find_target_digit_x()
            if cx is not None:
                self.cmd_pub.publish(Twist())
                self.col_pub.publish(Int32(data=self.target_column))
                self.get_logger().info(f'Found shelf {self.target_column} at pixel x={cx}. Centering...')
                self.state = 'CENTER'
                return
            twist = Twist()
            twist.angular.z = ROTATE_SPEED
            self.cmd_pub.publish(twist)
            return

        if self.state == 'CENTER':
            cx = self.find_target_digit_x()
            if self.latest_rgb is None:
                return
            img_center = self.latest_rgb.shape[1] / 2.0
            if cx is None:
                self._lost_ticks += 1
                twist = Twist()
                twist.angular.z = ROTATE_SPEED * 0.6
                self.cmd_pub.publish(twist)
                if self._lost_ticks > 80:
                    self.get_logger().warn('Lost target too long, resuming SEARCH')
                    self.state = 'SEARCH'
                    self._lost_ticks = 0
                return
            self._lost_ticks = 0
            error_px = cx - img_center
            if abs(error_px) < CENTER_TOLERANCE_PX:
                self.cmd_pub.publish(Twist())
                if self.current_yaw is None:
                    return
                # identify which physical slot by comparing centered
                # heading against the 5 known reference bearings
                best_idx = min(range(5), key=lambda i: abs(
                    angle_diff(SLOT_BEARINGS_FROM_START[i], self.current_yaw)))
                self._target_slot_idx = best_idx
                slot_x, slot_y, slot_yaw = SLOT_POSES[best_idx]
                self.get_logger().info(
                    f'Centered (yaw={self.current_yaw:.2f}). Matched physical slot {best_idx + 1} '
                    f'(bearing={SLOT_BEARINGS_FROM_START[best_idx]:.2f}). Driving there...')
                self.start_nav_to(slot_x, slot_y, slot_yaw)
                self.state = 'DRIVE_TO_SLOT'
                return
            twist = Twist()
            twist.angular.z = max(min(-CENTER_GAIN * error_px, 0.5), -0.5)
            self.cmd_pub.publish(twist)
            return

        if self.state == 'DRIVE_TO_SLOT':
            if self.step_nav():
                self.get_logger().info('=== Arrived at shelf slot. Starting book search... ===')
                self.state = 'BOOK_SWEEP'
            return

        if self.state == 'BOOK_SWEEP':
            if not self._book_tilt_sent:
                self.send_head(0.0, BOOK_SCAN_TILT)
                self._book_dwell = 0.0
                self._book_tilt_sent = True
                self.get_logger().info(f'Scanning shelf at tilt={BOOK_SCAN_TILT} for {self.target_colour} book...')
                return
            self._book_dwell += 0.1
            if self._book_dwell < 1.2:
                return
            if self.latest_rgb is not None and self.latest_depth is not None and self.fx is not None:
                centre = self.detect_colour(self.latest_rgb)
                if centre is not None:
                    px, py = centre
                    depth = float(self.latest_depth[py, px])
                    if depth > 0.0 and not np.isnan(depth):
                        point_cam = PointStamped()
                        point_cam.header.stamp = rclpy.time.Time().to_msg()
                        point_cam.header.frame_id = CAMERA_OPTICAL_FRAME
                        point_cam.point.x = (px - self.cx) * depth / self.fx
                        point_cam.point.y = (py - self.cy) * depth / self.fy
                        point_cam.point.z = depth
                        try:
                            point_base = self.tf_buffer.transform(
                                point_cam, 'base_link', timeout=RclpyDuration(seconds=1.0))
                            row_num = self._row_from_base_link_z(point_base.point.z)
                        except Exception as e:
                            self.get_logger().warn(f'tf2 transform for row calc failed: {e} -- retrying')
                            self._book_dwell = 0.0
                            self._book_scan_attempts += 1
                            if self._book_scan_attempts > 30:
                                self.get_logger().error('Too many failed row-calc attempts, giving up.')
                                self.state = 'FAILED'
                            return

                        self.row_pub.publish(Int32(data=row_num))
                        self.publish_point(px, py, depth)
                        self.get_logger().info(
                            f'Found {self.target_colour} book (measured row {row_num}, '
                            f'base_link z={point_base.point.z:.3f}). '
                            f'Published for manipulation_node. Waiting for it to reach standoff pose...')
                        self._ready_to_creep = False
                        self._contact_detected = False
                        self._contact_time = None
                        self._grasp_result = None
                        self._grasp_wait_elapsed = 0.0
                        self.state = 'WAIT_FOR_STANDOFF'
                        return
            self._book_scan_attempts += 1
            if self._book_scan_attempts > 30:
                self.get_logger().error(f'Never found {self.target_colour} book after repeated scans.')
                self.state = 'FAILED'
                return
            self._book_dwell = 0.0
            return

        if self.state == 'WAIT_FOR_STANDOFF':
            self._grasp_wait_elapsed += 0.1
            if self._ready_to_creep:
                self.get_logger().info('manipulation_node ready. Creeping forward to contact...')
                self.cmd_pub.publish(Twist())
                self._creep_start_x = self.current_x
                self._creep_start_y = self.current_y
                self._contact_detected = False
                self._contact_time = None
                self.state = 'CREEPING'
                return
            if self._grasp_wait_elapsed > 320.0:  # generous -- torso raise + arm reach can legitimately take several minutes
                self.get_logger().error('Timed out waiting for manipulation_node to reach standoff pose. Stopping.')
                self.state = 'FAILED'
                return
            return

        if self.state == 'CREEPING':
            if self.current_x is None or self._creep_start_x is None:
                return
            traveled = math.hypot(self.current_x - self._creep_start_x,
                                   self.current_y - self._creep_start_y)
            if self._contact_detected:
                # Start the post-contact timer only once, on the first detected contact.
                if self._contact_time is None:
                    self._contact_time = self.get_clock().now()
                    self.get_logger().info(
                        f'Contact detected after creeping {traveled:.3f}m. '
                        'Continuing forward for 3.0 seconds...'
                    )

                elapsed_after_contact = (
                    self.get_clock().now() - self._contact_time
                ).nanoseconds / 1e9

                # Keep creeping for 3 seconds after the first contact so a
                # slightly misaligned book can slide farther into the gripper.
                if elapsed_after_contact < 3.0:
                    twist = Twist()
                    twist.linear.x = CREEP_SPEED_MPS
                    self.cmd_pub.publish(twist)
                    return

                # The extra 3 seconds are complete: stop, then let the
                # manipulation node continue with the grasp.
                self.cmd_pub.publish(Twist())
                self.get_logger().info(
                    f'Post-contact creep complete after 3.0s. '
                    f'Total creep distance: {traveled:.3f}m. Stopping.'
                )
                # Remember the COMPLETE forward creep distance.
                # This includes the approach before contact + the extra
                # 3-second forward movement after contact.
                self._creep_distance = traveled
                self.get_logger().info(
                    f'Saved creep distance: {self._creep_distance:.3f} m. '
                    'Will reverse this exact distance after grasp.'
                )

                self.creep_contact_pub.publish(Bool(data=True))
                self._grasp_wait_elapsed = 0.0
                self._contact_time = None
                self.state = 'WAIT_FOR_GRASP'
                return
            if traveled > MAX_CREEP_DISTANCE_M:
                self.cmd_pub.publish(Twist())
                self.get_logger().error(f'Creep safety limit ({MAX_CREEP_DISTANCE_M}m) reached with no contact.')
                self.creep_contact_pub.publish(Bool(data=False))
                self._grasp_wait_elapsed = 0.0
                self.state = 'WAIT_FOR_GRASP'
                return
            twist = Twist()
            twist.linear.x = CREEP_SPEED_MPS
            self.cmd_pub.publish(twist)
            return

        if self.state == 'WAIT_FOR_GRASP':
            # No timeout here -- the full grasp sequence (torso raise for
            # top rows + multi-step arm motion) can legitimately take a
            # while, and a fixed timeout was cutting it off mid-attempt.
            # We just wait indefinitely for an explicit True/False from
            # manipulation_node on /erc/grasp_result.
            if self._grasp_result is True:
                self.get_logger().info(
                    f'Grasp SUCCEEDED. Backing away from shelf by '
                    f'{self._creep_distance:.3f} m before returning to bin.'
                )

                self.cmd_pub.publish(Twist())

                self._backout_start_x = self.current_x
                self._backout_start_y = self.current_y

                self.state = 'BACKOUT'
                return
            if self._grasp_result is False:
                self.get_logger().error(
                    'Grasp FAILED (manipulation_node reported failure). '
                    'NOT returning to bin -- nothing to place. Stopping here.')
                self.state = 'FAILED'
                return
            return

        if self.state == 'BACKOUT':
            if (
                self.current_x is None
                or self.current_y is None
                or self._backout_start_x is None
                or self._backout_start_y is None
            ):
                return

            backed_distance = math.hypot(
                self.current_x - self._backout_start_x,
                self.current_y - self._backout_start_y
            )

            # Once we have reversed the exact creep distance,
            # stop first, THEN begin normal navigation to BIN_POSE.
            if backed_distance >= self._creep_distance:
                # FULL STOP before allowing any arm movement.
                self.cmd_pub.publish(Twist())

                self.get_logger().info(
                    f'Backout complete: {backed_distance:.3f} m. '
                    'Base stopped. Now allowing arm to lift.'
                )

                self._lift_result = None

                # Tell manipulation node the robot is now clear
                # of the shelf and arm movement is safe.
                self.backout_complete_pub.publish(Bool(data=True))

                self.state = 'WAIT_FOR_LIFT'
                return

            # Reverse at normal navigation speed, not creep speed.
            twist = Twist()
            twist.linear.x = -MAX_LINEAR
            self.cmd_pub.publish(twist)
            return

        if self.state == 'WAIT_FOR_LIFT':
            # Keep the base completely stationary while the arm lifts.
            self.cmd_pub.publish(Twist())

            if self._lift_result is True:
                self.get_logger().info(
                    'Lift completed. Now returning to bin/origin waypoint.'
                )

                self.start_nav_to(*BIN_POSE)
                self.state = 'RETURN_TO_BIN'
                return

            if self._lift_result is False:
                self.get_logger().error(
                    'Post-backout lift failed. Stopping.'
                )
                self.state = 'FAILED'
                return

            return

        if self.state == 'RETURN_TO_BIN':
            if self.step_nav():
                self.get_logger().info('=== Arrived at bin drop-off pose. Looking for the bin... ===')
                self._bin_scan_tilt_sent = False
                self._bin_scan_dwell = 0.0
                self.state = 'FIND_BIN'
            return

        if self.state == 'FIND_BIN':
            if not self._bin_scan_tilt_sent:
                self.send_head(0.0, BOOK_SCAN_TILT)  # reuse the same tilt that worked for the shelf
                self._bin_scan_dwell = 0.0
                self._bin_scan_tilt_sent = True
                return
            self._bin_scan_dwell += 0.1
            if self._bin_scan_dwell < 1.2:
                return
            if self.latest_rgb is not None and self.latest_depth is not None and self.fx is not None:
                old_colour = self.target_colour
                self.target_colour = 'red'  # the collection bin is red -- reuse the same detector
                centre = self.detect_colour(self.latest_rgb)
                self.target_colour = old_colour
                if centre is not None:
                    px, py = centre
                    depth = float(self.latest_depth[py, px])
                    if depth > 0.0 and not np.isnan(depth):
                        point_msg = PointStamped()
                        point_msg.header.stamp = self.get_clock().now().to_msg()
                        point_msg.header.frame_id = CAMERA_OPTICAL_FRAME
                        point_msg.point.x = (px - self.cx) * depth / self.fx
                        point_msg.point.y = (py - self.cy) * depth / self.fy
                        point_msg.point.z = depth
                        self.bin_point_pub.publish(point_msg)
                        self.get_logger().info('Found the bin. Published its position, waiting for place result...')
                        self._place_result = None
                        self.state = 'WAIT_FOR_PLACE'
                        return
            if self._bin_scan_dwell > 5.0:
                self.get_logger().error('Never found the (red) bin -- stopping.')
                self.state = 'FAILED'
            return

        if self.state == 'WAIT_FOR_PLACE':
            if self._place_result is True:
                self.get_logger().info('=== Book placed in bin successfully! Task complete. ===')
                self.state = 'DONE'
                return
            if self._place_result is False:
                self.get_logger().error('Failed to place book in bin.')
                self.state = 'FAILED'
                return
            return

        if self.state in ('DONE', 'FAILED'):
            self.cmd_pub.publish(Twist())


def main():
    rclpy.init()
    node = WaypointNavFinal()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.cmd_pub.publish(Twist())
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
