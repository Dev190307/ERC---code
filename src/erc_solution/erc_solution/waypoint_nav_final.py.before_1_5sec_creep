# Horizontal region-of-interest (as a fraction of image width) the book-colour
# search is restricted to, since the head camera's 87-degree FOV at close
# shelf-approach range sees the NEIGHBORING columns too -- searching the full
# frame lets a same-coloured book on an adjacent column win by contour size.
# Restricting to a central band keeps the search on the column the robot is
# actually squared up against. Tune these two fractions against a saved
# frame (see /tmp/shelf_frame.png) if the crop needs adjusting.
BOOK_ROI_X_MIN_FRAC = 0.22
BOOK_ROI_X_MAX_FRAC = 0.72  # tightened from 0.78 -- a neighboring column's book was bleeding into the right edge, confirmed visually

POS_TOLERANCE_M = 0.05
YAW_TOLERANCE_RAD = 0.03
MAX_LINEAR = 0.4
MAX_ANGULAR = 0.3

COLOR_RANGES = {
    "red": [
        (np.array([0, 120, 70]), np.array([10, 255, 255])),
        (np.array([170, 120, 70]), np.array([180, 255, 255])),
    ],
    "blue": [(np.array([100, 120, 70]), np.array([130, 255, 255]))],
    "green": [(np.array([40, 70, 70]), np.array([80, 255, 255]))],
    "yellow": [(np.array([20, 100, 100]), np.array([35, 255, 255]))],
}
