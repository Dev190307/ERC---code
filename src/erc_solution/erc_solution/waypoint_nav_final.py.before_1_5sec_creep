]

TILT_UP = 0.3
ROTATE_SPEED = -0.4        # confirmed clockwise
CENTER_TOLERANCE_PX = 15
CENTER_GAIN = 0.0015
SEARCH_TIMEOUT_S = 40.0

BOOK_SCAN_TILT = -0.3
BOOK_DWELL_SEC = 2.0
MIN_CONTOUR_AREA = 100

ROW_BOUNDARIES = [1.35, 1.02, 0.69]

READY_TO_CREEP_TOPIC = '/erc/ready_to_creep'
