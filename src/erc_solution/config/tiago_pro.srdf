<?xml version="1.0" ?>
<robot name="tiago_pro">

  <group name="arm_left">
    <chain base_link="torso_lift_link" tip_link="gripper_left_grasping_link"/>
  </group>

  <group_state name="arm_left_home" group="arm_left">
    <joint name="arm_left_1_joint" value="0"/>
    <joint name="arm_left_2_joint" value="0"/>
    <joint name="arm_left_3_joint" value="0"/>
    <joint name="arm_left_4_joint" value="0"/>
    <joint name="arm_left_5_joint" value="0"/>
    <joint name="arm_left_6_joint" value="0"/>
    <joint name="arm_left_7_joint" value="0"/>
  </group_state>

  <disable_collisions link1="torso_base_link" link2="torso_lift_link" reason="Adjacent"/>
